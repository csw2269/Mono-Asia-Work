    gv_mbVoteTitle = DialogControlCreate(gv_mbVoteDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(gv_mbVoteTitle, PlayerGroupAll(), 560, 42);
    DialogControlSetPosition(gv_mbVoteTitle, PlayerGroupAll(), c_anchorTop, 0, 18);
    DialogControlSetPropertyAsText(gv_mbVoteTitle, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("MONOBATTLE 게임 모드 투표"));

    gv_mbVoteInfo = DialogControlCreate(gv_mbVoteDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(gv_mbVoteInfo, PlayerGroupAll(), 560, 30);
    DialogControlSetPosition(gv_mbVoteInfo, PlayerGroupAll(), c_anchorTop, 0, 64);

    gv_mbVoteBlindButton = DialogControlCreate(gv_mbVoteDialog, c_triggerControlTypeButton);
    DialogControlSetSize(gv_mbVoteBlindButton, PlayerGroupAll(), 250, 60);
    DialogControlSetPosition(gv_mbVoteBlindButton, PlayerGroupAll(), c_anchorBottomLeft, 45, -28);
    DialogControlSetPropertyAsText(gv_mbVoteBlindButton, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("BLIND RANDOM"));

    gv_mbVoteSDButton = DialogControlCreate(gv_mbVoteDialog, c_triggerControlTypeButton);
    DialogControlSetSize(gv_mbVoteSDButton, PlayerGroupAll(), 250, 60);
    DialogControlSetPosition(gv_mbVoteSDButton, PlayerGroupAll(), c_anchorBottomRight, -45, -28);
    DialogControlSetPropertyAsText(gv_mbVoteSDButton, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("SINGLE DRAFT"));

    DialogSetVisible(gv_mbVoteDialog, PlayerGroupAll(), false);
}

