//==================================================================================================
// Monobattle - Tropic Shores / 열대 해안
// Alpha 1: mode vote + Blind Random selection/reveal/reroll prototype
//==================================================================================================
include "TriggerLibs/NativeLib"

void InitLibs () {
    libNtve_InitLib();
}

//--------------------------------------------------------------------------------------------------
// Constants
//--------------------------------------------------------------------------------------------------
const int MB_PHASE_NONE       = 0;
const int MB_PHASE_MODE_VOTE  = 1;
const int MB_PHASE_BLIND      = 2;
const int MB_PHASE_RUNNING    = 3;

const int MB_MODE_NONE        = 0;
const int MB_MODE_BLIND       = 1;
const int MB_MODE_SD          = 2;

const int MB_RACE_NONE        = 0;
const int MB_RACE_TERRAN      = 1;
const int MB_RACE_ZERG        = 2;
const int MB_RACE_PROTOSS     = 3;
const int MB_RACE_RANDOM      = 4;

const fixed MB_VOTE_SECONDS   = 20.0;
const fixed MB_BLIND_SECONDS  = 30.0;

//--------------------------------------------------------------------------------------------------
// Globals
//--------------------------------------------------------------------------------------------------
trigger gt_MeleeInitialization;
trigger gt_MBDialogClick;
trigger gt_MBPhaseTimeout;
trigger gt_MBTick;

timer gv_mbTimer;
int gv_mbPhase;
int gv_mbMode;

int[9] gv_mbVote;
int[9] gv_mbRaceChoice;
string[9] gv_mbUnit;
string[9] gv_mbPreviousUnit;
bool[9] gv_mbCanReroll;
bool[9] gv_mbRerollUsed;

int gv_mbVoteDialog;
int gv_mbVoteTitle;
int gv_mbVoteInfo;
int gv_mbVoteBlindButton;
int gv_mbVoteSDButton;

int gv_mbBlindDialog;
int gv_mbBlindTitle;
int gv_mbBlindInfo;
int gv_mbTerranButton;
int gv_mbZergButton;
int gv_mbProtossButton;
int gv_mbRandomButton;
int gv_mbRerollButton;
int gv_mbTeamLabel;

string[16] gv_mbTerran;
string[16] gv_mbTerranDisplay;
int gv_mbTerranCount;

string[16] gv_mbZerg;
string[16] gv_mbZergDisplay;
int gv_mbZergCount;

string[16] gv_mbProtoss;
string[16] gv_mbProtossDisplay;
int gv_mbProtossCount;

//--------------------------------------------------------------------------------------------------
