//--------------------------------------------------------------------------------------------------
// Phases
//--------------------------------------------------------------------------------------------------
void MB_StartVote () {
    int p = 1;
    gv_mbPhase = MB_PHASE_MODE_VOTE;
    gv_mbMode = MB_MODE_NONE;
    while (p <= 8) {
        gv_mbVote[p] = MB_MODE_NONE;
        p += 1;
    }

    UnitPauseAll(true);
    DialogSetVisible(gv_mbBlindDialog, PlayerGroupAll(), false);
    DialogSetVisible(gv_mbVoteDialog, PlayerGroupAll(), true);
    TimerStart(gv_mbTimer, MB_VOTE_SECONDS, false, c_timeReal);
    MB_UpdateVoteUI();
}

void MB_StartBlind () {
    int p = 1;
    gv_mbPhase = MB_PHASE_BLIND;
    while (p <= 8) {
        gv_mbRaceChoice[p] = MB_RACE_NONE;
        gv_mbUnit[p] = "";
        gv_mbPreviousUnit[p] = "";
        gv_mbCanReroll[p] = false;
        gv_mbRerollUsed[p] = false;
        p += 1;
    }

    DialogSetVisible(gv_mbVoteDialog, PlayerGroupAll(), false);
    DialogSetVisible(gv_mbBlindDialog, PlayerGroupAll(), true);
    TimerStart(gv_mbTimer, MB_BLIND_SECONDS, false, c_timeReal);
    MB_UpdateAllTeamReveal();
}

void MB_FinishBlind () {
    int p = 1;
    while (p <= 8) {
        if (MB_PlayerActive(p) && gv_mbUnit[p] == "") {
            // AFK/no selection: auto Random at timeout. No practical reroll time remains.
            MB_AssignRace(p, MB_RACE_RANDOM, true);
        }
        p += 1;
    }

    gv_mbPhase = MB_PHASE_RUNNING;
    DialogSetVisible(gv_mbBlindDialog, PlayerGroupAll(), false);
    UnitPauseAll(false);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
        StringToText("Alpha 1 선택 단계 완료. 생산 제한은 다음 Alpha에서 적용됩니다."));
}

void MB_ResolveVote () {
    int blind = MB_CountVotes(MB_MODE_BLIND);
    int sd = MB_CountVotes(MB_MODE_SD);

    if (blind > sd) { gv_mbMode = MB_MODE_BLIND; }
    else if (sd > blind) { gv_mbMode = MB_MODE_SD; }
    else { gv_mbMode = RandomInt(MB_MODE_BLIND, MB_MODE_SD); }

    if (gv_mbMode == MB_MODE_SD) {
        // Alpha 1 tests the vote path, but Single Draft board logic lands in the next build.
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
            StringToText("Single Draft 투표 경로 확인 완료 - Alpha 1에서는 Blind Random 테스트로 전환합니다."));
    }
    MB_StartBlind();
}

//--------------------------------------------------------------------------------------------------
// Trigger handlers
//--------------------------------------------------------------------------------------------------
bool gt_MBDialogClick_Func (bool testConds, bool runActions) {
    int control;
    int p;
    if (!runActions) { return true; }

    control = EventDialogControl();
    p = EventPlayer();

    if (gv_mbPhase == MB_PHASE_MODE_VOTE) {
        if (control == gv_mbVoteBlindButton) { gv_mbVote[p] = MB_MODE_BLIND; MB_UpdateVoteUI(); }
        else if (control == gv_mbVoteSDButton) { gv_mbVote[p] = MB_MODE_SD; MB_UpdateVoteUI(); }
        return true;
    }

    if (gv_mbPhase == MB_PHASE_BLIND) {
        if (control == gv_mbTerranButton) { MB_AssignRace(p, MB_RACE_TERRAN, false); }
        else if (control == gv_mbZergButton) { MB_AssignRace(p, MB_RACE_ZERG, false); }
        else if (control == gv_mbProtossButton) { MB_AssignRace(p, MB_RACE_PROTOSS, false); }
        else if (control == gv_mbRandomButton) { MB_AssignRace(p, MB_RACE_RANDOM, true); }
        else if (control == gv_mbRerollButton) { MB_RerollPlayer(p); }
    }
    return true;
}

bool gt_MBPhaseTimeout_Func (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    if (gv_mbPhase == MB_PHASE_MODE_VOTE) { MB_ResolveVote(); }
    else if (gv_mbPhase == MB_PHASE_BLIND) { MB_FinishBlind(); }
    return true;
}

bool gt_MBTick_Func (bool testConds, bool runActions) {
    int remain;
    if (!runActions) { return true; }

    if (gv_mbPhase == MB_PHASE_MODE_VOTE) {
        MB_UpdateVoteUI();
    }
    else if (gv_mbPhase == MB_PHASE_BLIND) {
        remain = FixedToInt(TimerGetRemaining(gv_mbTimer));
        DialogControlSetPropertyAsText(gv_mbBlindInfo, c_triggerControlPropertyText, PlayerGroupAll(),
            StringToText("남은 시간: " + IntToString(remain) + "초   |   Random만 리롤 1회 가능"));
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Melee Initialization
//--------------------------------------------------------------------------------------------------
bool gt_MeleeInitialization_Func (bool testConds, bool runActions) {
    if (!runActions) { return true; }

    MeleeInitResources();
    MeleeInitUnits();
    MeleeInitAI();
    MeleeInitOptions();

    MB_InitUnitPool();
    gv_mbTimer = TimerCreate();
    MB_CreateVoteUI();
    MB_CreateBlindUI();
    MB_StartVote();
    return true;
}

void gt_MeleeInitialization_Init () {
    gt_MeleeInitialization = TriggerCreate("gt_MeleeInitialization_Func");
    TriggerAddEventMapInit(gt_MeleeInitialization);
}

void gt_MBDialogClick_Init () {
    gt_MBDialogClick = TriggerCreate("gt_MBDialogClick_Func");
    TriggerAddEventDialogControl(gt_MBDialogClick, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

void gt_MBPhaseTimeout_Init () {
    gt_MBPhaseTimeout = TriggerCreate("gt_MBPhaseTimeout_Func");
    TriggerAddEventTimer(gt_MBPhaseTimeout, gv_mbTimer);
}

void gt_MBTick_Init () {
    gt_MBTick = TriggerCreate("gt_MBTick_Func");
    TriggerAddEventTimePeriodic(gt_MBTick, 1.0, c_timeReal);
}

void InitTriggers () {
    // Timer must exist before registering its expiry event.
    gv_mbTimer = TimerCreate();
    gt_MeleeInitialization_Init();
    gt_MBDialogClick_Init();
    gt_MBPhaseTimeout_Init();
    gt_MBTick_Init();
}

void InitMap () {
    InitLibs();
    InitTriggers();
}
