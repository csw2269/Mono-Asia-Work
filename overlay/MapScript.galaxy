//--------------------------------------------------------------------------------------------------
// Phase flow
//--------------------------------------------------------------------------------------------------
void MB_StartVote () {
    int p = 1;
    gv_mbPhase = MB_PHASE_MODE_VOTE;
    gv_mbMode = MB_MODE_NONE;
    while (p <= 8) { gv_mbVote[p] = MB_MODE_NONE; MB_ResetVoteButtonTextFor(p); p += 1; }
    UnitPauseAll(true);
    DialogSetVisible(gv_mbBlindDialog, PlayerGroupAll(), false);
    DialogSetVisible(gv_mbSDDialog, PlayerGroupAll(), false);
    DialogSetVisible(gv_mbVoteDialog, PlayerGroupAll(), true);
    TimerStart(gv_mbTimer, MB_VOTE_SECONDS, false, c_timeReal);
    MB_UpdateVoteUI();
}

void MB_StartBlind () {
    int p = 1;
    gv_mbPhase = MB_PHASE_BLIND;
    while (p <= 8) {
        gv_mbRaceChoice[p] = MB_RACE_NONE;
        gv_mbUnit[p] = "";
        gv_mbPreviousUnit[p] = "";
        gv_mbCanReroll[p] = false;
        gv_mbRerollUsed[p] = false;
        DialogControlSetEnabled(gv_mbTerranButton, PlayerGroupSingle(p), true);
        DialogControlSetEnabled(gv_mbZergButton, PlayerGroupSingle(p), true);
        DialogControlSetEnabled(gv_mbProtossButton, PlayerGroupSingle(p), true);
        DialogControlSetEnabled(gv_mbRandomButton, PlayerGroupSingle(p), true);
        DialogControlSetVisible(gv_mbRerollButton, PlayerGroupSingle(p), false);
        DialogControlSetPropertyAsText(gv_mbBlindStatus, c_triggerControlPropertyText, PlayerGroupSingle(p), StringToText("종족을 고르는 즉시 유닛이 확정됩니다"));
        p += 1;
    }
    DialogSetVisible(gv_mbVoteDialog, PlayerGroupAll(), false);
    DialogSetVisible(gv_mbBlindDialog, PlayerGroupAll(), true);
    TimerStart(gv_mbTimer, MB_BLIND_SECONDS, false, c_timeReal);
    MB_UpdateAllTeamReveal();
}

void MB_StartSD () {
    int p = 1;
    gv_mbPhase = MB_PHASE_SD;
    while (p <= 8) { gv_mbUnit[p] = ""; gv_mbCanReroll[p] = false; gv_mbRerollUsed[p] = false; p += 1; }
    MB_SDGenerateInitialBoard();
    MB_SDRepairBoard();
    MB_SDBuildTeamsAndOrder();
    gv_mbSDPickIndex = 0;
    DialogSetVisible(gv_mbVoteDialog, PlayerGroupAll(), false);
    DialogSetVisible(gv_mbSDDialog, PlayerGroupAll(), true);
    if (gv_mbSDOrderCount <= 0) { return; }
    TimerStart(gv_mbTimer, MB_SD_PICK_SECONDS, false, c_timeReal);
    MB_SDUpdateTurn();
}

void MB_FinishSelection () {
    gv_mbPhase = MB_PHASE_RUNNING;
    DialogSetVisible(gv_mbBlindDialog, PlayerGroupAll(), false);
    DialogSetVisible(gv_mbSDDialog, PlayerGroupAll(), false);
    MB_ApplyProductionRestrictionsAll();
    UnitPauseAll(false);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Monobattle 선택 완료 · 생산 제한 적용"));
}

void MB_FinishBlind () {
    int p = 1;
    while (p <= 8) {
        if (MB_PlayerActive(p) && gv_mbUnit[p] == "") { MB_AssignRace(p, MB_RACE_RANDOM, true); }
        p += 1;
    }
    MB_FinishSelection();
}

void MB_SDPickSlot (int player, int slot) {
    if (gv_mbPhase != MB_PHASE_SD || gv_mbSDPickIndex >= gv_mbSDOrderCount) { return; }
    if (player != gv_mbSDOrder[gv_mbSDPickIndex]) { return; }
    if (slot < 0 || slot >= MB_SD_CANDIDATES || gv_mbSDTaken[slot]) { return; }
    gv_mbUnit[player] = gv_mbSDCandidate[slot];
    gv_mbSDTaken[slot] = true;
    gv_mbSDPickIndex += 1;
    if (gv_mbSDPickIndex >= gv_mbSDOrderCount) { MB_FinishSelection(); return; }
    TimerStart(gv_mbTimer, MB_SD_PICK_SECONDS, false, c_timeReal);
    MB_SDUpdateTurn();
}

void MB_SDAutoPick () {
    int p;
    int start;
    int step = 0;
    int slot;
    if (gv_mbSDPickIndex >= gv_mbSDOrderCount) { return; }
    p = gv_mbSDOrder[gv_mbSDPickIndex];
    start = RandomInt(0, MB_SD_CANDIDATES - 1);
    while (step < MB_SD_CANDIDATES) {
        slot = (start + step) % MB_SD_CANDIDATES;
        if (!gv_mbSDTaken[slot]) { MB_SDPickSlot(p, slot); return; }
        step += 1;
    }
}

void MB_ResolveVote () {
    int blind = MB_CountVotes(MB_MODE_BLIND);
    int sd = MB_CountVotes(MB_MODE_SD);
    if (blind > sd) { gv_mbMode = MB_MODE_BLIND; }
    else if (sd > blind) { gv_mbMode = MB_MODE_SD; }
    else { gv_mbMode = RandomInt(MB_MODE_BLIND, MB_MODE_SD); }
    if (gv_mbMode == MB_MODE_SD) { MB_StartSD(); }
    else { MB_StartBlind(); }
}

//--------------------------------------------------------------------------------------------------
// Trigger handlers
//--------------------------------------------------------------------------------------------------
bool gt_MBDialogClick_Func (bool testConds, bool runActions) {
    int control;
    int p;
    int i;
    if (!runActions) { return true; }
    control = EventDialogControl();
    p = EventPlayer();

    if (gv_mbPhase == MB_PHASE_MODE_VOTE) {
        if (control == gv_mbVoteBlindButton) { gv_mbVote[p] = MB_MODE_BLIND; MB_ResetVoteButtonTextFor(p); MB_UpdateVoteUI(); }
        else if (control == gv_mbVoteSDButton) { gv_mbVote[p] = MB_MODE_SD; MB_ResetVoteButtonTextFor(p); MB_UpdateVoteUI(); }
        return true;
    }

    if (gv_mbPhase == MB_PHASE_BLIND) {
        if (control == gv_mbTerranButton) { MB_AssignRace(p, MB_RACE_TERRAN, false); }
        else if (control == gv_mbZergButton) { MB_AssignRace(p, MB_RACE_ZERG, false); }
        else if (control == gv_mbProtossButton) { MB_AssignRace(p, MB_RACE_PROTOSS, false); }
        else if (control == gv_mbRandomButton) { MB_AssignRace(p, MB_RACE_RANDOM, true); }
        else if (control == gv_mbRerollButton) { MB_RerollPlayer(p); }
        return true;
    }

    if (gv_mbPhase == MB_PHASE_SD) {
        i = 0;
        while (i < MB_SD_CANDIDATES) {
            if (control == gv_mbSDButton[i]) { MB_SDPickSlot(p, i); return true; }
            i += 1;
        }
    }
    return true;
}

bool gt_MBPhaseTimeout_Func (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    if (gv_mbPhase == MB_PHASE_MODE_VOTE) { MB_ResolveVote(); }
    else if (gv_mbPhase == MB_PHASE_BLIND) { MB_FinishBlind(); }
    else if (gv_mbPhase == MB_PHASE_SD) { MB_SDAutoPick(); }
    return true;
}

bool gt_MBTick_Func (bool testConds, bool runActions) {
    int remain;
    if (!runActions) { return true; }
    if (gv_mbPhase == MB_PHASE_MODE_VOTE) { MB_UpdateVoteUI(); }
    else if (gv_mbPhase == MB_PHASE_BLIND) {
        remain = FixedToInt(TimerGetRemaining(gv_mbTimer));
        DialogControlSetPropertyAsText(gv_mbBlindInfo, c_triggerControlPropertyText, PlayerGroupAll(),
            StringToText("남은 시간  " + IntToString(remain) + "초     ·     먼저 고를수록 팀의 리롤 판단 시간이 늘어납니다"));
    }
    else if (gv_mbPhase == MB_PHASE_SD) { MB_SDUpdateTurn(); }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Melee Initialization
//--------------------------------------------------------------------------------------------------
bool gt_MeleeInitialization_Func (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    MeleeInitResources();
    MeleeInitUnits();
    MeleeInitAI();
    // Stock MeleeInitOptions is intentionally omitted. Monobattle will own victory/defeat logic;
    // this also prevents an instant victory when testing the map alone.

    MB_InitUnitPool();
    MB_CreateVoteUI();
    MB_CreateBlindUI();
    MB_CreateSDUI();
    MB_StartVote();
    return true;
}

void gt_MeleeInitialization_Init () {
    gt_MeleeInitialization = TriggerCreate("gt_MeleeInitialization_Func");
    TriggerAddEventMapInit(gt_MeleeInitialization);
}

void gt_MBDialogClick_Init () {
    gt_MBDialogClick = TriggerCreate("gt_MBDialogClick_Func");
    TriggerAddEventDialogControl(gt_MBDialogClick, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

void gt_MBPhaseTimeout_Init () {
    gt_MBPhaseTimeout = TriggerCreate("gt_MBPhaseTimeout_Func");
    TriggerAddEventTimer(gt_MBPhaseTimeout, gv_mbTimer);
}

void gt_MBTick_Init () {
    gt_MBTick = TriggerCreate("gt_MBTick_Func");
    TriggerAddEventTimePeriodic(gt_MBTick, 1.0, c_timeReal);
}

void InitTriggers () {
    gv_mbTimer = TimerCreate();
    gt_MeleeInitialization_Init();
    gt_MBDialogClick_Init();
    gt_MBPhaseTimeout_Init();
    gt_MBTick_Init();
}

void InitMap () {
    InitLibs();
    InitTriggers();
}
