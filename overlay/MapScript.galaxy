//--------------------------------------------------------------------------------------------------
// Unit metadata
//--------------------------------------------------------------------------------------------------
bool MB_PlayerActive (int p) {
    return (p >= 1 && p <= 8 && PlayerStatus(p) == c_playerStatusActive);
}

int MB_PoolCount (int race) {
    if (race == MB_RACE_TERRAN) { return gv_mbTerranCount; }
    if (race == MB_RACE_ZERG) { return gv_mbZergCount; }
    return gv_mbProtossCount;
}

string MB_PoolUnit (int race, int index) {
    if (race == MB_RACE_TERRAN) { return gv_mbTerran[index]; }
    if (race == MB_RACE_ZERG) { return gv_mbZerg[index]; }
    return gv_mbProtoss[index];
}

int MB_UnitRace (string unitId) {
    int i = 0;
    while (i < gv_mbTerranCount) { if (gv_mbTerran[i] == unitId) { return MB_RACE_TERRAN; } i += 1; }
    i = 0;
    while (i < gv_mbZergCount) { if (gv_mbZerg[i] == unitId) { return MB_RACE_ZERG; } i += 1; }
    return MB_RACE_PROTOSS;
}

string MB_DisplayName (string unitId) {
    int i = 0;
    while (i < gv_mbTerranCount) { if (gv_mbTerran[i] == unitId) { return gv_mbTerranDisplay[i]; } i += 1; }
    i = 0;
    while (i < gv_mbZergCount) { if (gv_mbZerg[i] == unitId) { return gv_mbZergDisplay[i]; } i += 1; }
    i = 0;
    while (i < gv_mbProtossCount) { if (gv_mbProtoss[i] == unitId) { return gv_mbProtossDisplay[i]; } i += 1; }
    return unitId;
}

bool MB_IsAir (string u) {
    return (u == "VikingFighter" || u == "Banshee" || u == "Raven" || u == "Battlecruiser" || u == "Liberator" ||
            u == "Mutalisk" || u == "Corruptor" || u == "BroodLord" || u == "Viper" ||
            u == "Phoenix" || u == "VoidRay" || u == "Oracle" || u == "Tempest" || u == "Carrier");
}

int MB_UnitRole (string u) {
    if (u == "Raven" || u == "Infestor" || u == "Viper" || u == "HighTemplar") { return MB_ROLE_CASTER; }
    if (u == "WidowMine" || u == "Ghost" || u == "Queen" || u == "SwarmHostMP" || u == "Sentry" || u == "Disruptor" || u == "Oracle") { return MB_ROLE_HYBRID; }
    return MB_ROLE_DIRECT;
}

bool MB_IsHighWorkload (string u) {
    return (u == "Raven" || u == "Infestor" || u == "Viper" || u == "HighTemplar" || u == "Disruptor" || u == "Oracle");
}

int MB_AAScore2 (string u) {
    // 2 = reliable AA, 1 = conditional/spell AA, 0 = none. Score is doubled to avoid fixed math.
    if (u == "Marine" || u == "WidowMine" || u == "Cyclone" || u == "Thor" || u == "VikingFighter" ||
        u == "Battlecruiser" || u == "Liberator" || u == "Ghost" || u == "Hydralisk" || u == "Mutalisk" ||
        u == "Corruptor" || u == "Queen" || u == "Stalker" || u == "Sentry" || u == "Archon" ||
        u == "Phoenix" || u == "VoidRay" || u == "Tempest" || u == "Carrier") { return 2; }
    if (u == "Infestor" || u == "Viper" || u == "HighTemplar") { return 1; }
    return 0;
}

bool MB_IsHeldByOther (string unitId, int exceptPlayer) {
    int p = 1;
    while (p <= 8) {
        if (p != exceptPlayer && gv_mbUnit[p] == unitId) { return true; }
        p += 1;
    }
    return false;
}

bool MB_SDCandidateHas (string unitId) {
    int i = 0;
    while (i < MB_SD_CANDIDATES) {
        if (gv_mbSDCandidate[i] == unitId) { return true; }
        i += 1;
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// Blind Random draw
//--------------------------------------------------------------------------------------------------
string MB_DrawFromRace (int race, int player, string personalExclude) {
    int count = MB_PoolCount(race);
    int start;
    int step = 0;
    int idx;
    string candidate;
    if (count <= 0) { return ""; }
    start = RandomInt(0, count - 1);
    while (step < count) {
        idx = (start + step) % count;
        candidate = MB_PoolUnit(race, idx);
        if (candidate != personalExclude && !MB_IsHeldByOther(candidate, player)) { return candidate; }
        step += 1;
    }
    return "";
}

string MB_DrawRandomRace (int player, string personalExclude) {
    int firstRace = RandomInt(1, 3);
    int offset = 0;
    int race;
    string result;
    while (offset < 3) {
        race = ((firstRace - 1 + offset) % 3) + 1;
        result = MB_DrawFromRace(race, player, personalExclude);
        if (result != "") { return result; }
        offset += 1;
    }
    return "";
}

//--------------------------------------------------------------------------------------------------
// UI helpers
//--------------------------------------------------------------------------------------------------
void MB_SetPanelLook (int control) {
    DialogControlSetPropertyAsBool(control, c_triggerControlPropertyBackgroundVisible, PlayerGroupAll(), true);
    DialogControlSetPropertyAsBool(control, c_triggerControlPropertyBorderVisible, PlayerGroupAll(), true);
    DialogControlSetPropertyAsColor(control, c_triggerControlPropertyFillColor, PlayerGroupAll(), ColorWithAlpha(5.0, 9.0, 15.0, 92.0));
    DialogControlSetPropertyAsColor(control, c_triggerControlPropertyBorderColor, PlayerGroupAll(), Color(25.0, 48.0, 70.0));
}

text MB_TeamTagText (int team, string s) {
    if (team == 0) { return TextWithColor(StringToText(s), Color(35.0, 70.0, 100.0)); }
    return TextWithColor(StringToText(s), Color(100.0, 45.0, 35.0));
}

void MB_ResetVoteButtonTextFor (int p) {
    playergroup one = PlayerGroupSingle(p);
    if (gv_mbVote[p] == MB_MODE_BLIND) {
        DialogControlSetPropertyAsText(gv_mbVoteBlindButton, c_triggerControlPropertyText, one, StringToText("BLIND RANDOM\n[ 내 선택 ]"));
        DialogControlSetPropertyAsText(gv_mbVoteSDButton, c_triggerControlPropertyText, one, StringToText("SINGLE DRAFT\n24개 후보 드래프트"));
    }
    else if (gv_mbVote[p] == MB_MODE_SD) {
        DialogControlSetPropertyAsText(gv_mbVoteBlindButton, c_triggerControlPropertyText, one, StringToText("BLIND RANDOM\n종족 선택 + 즉시 추첨"));
        DialogControlSetPropertyAsText(gv_mbVoteSDButton, c_triggerControlPropertyText, one, StringToText("SINGLE DRAFT\n[ 내 선택 ]"));
    }
    else {
        DialogControlSetPropertyAsText(gv_mbVoteBlindButton, c_triggerControlPropertyText, one, StringToText("BLIND RANDOM\n종족 선택 + 즉시 추첨"));
        DialogControlSetPropertyAsText(gv_mbVoteSDButton, c_triggerControlPropertyText, one, StringToText("SINGLE DRAFT\n24개 후보 드래프트"));
    }
}

int MB_CountVotes (int mode) {
    int p = 1;
    int count = 0;
    while (p <= 8) { if (MB_PlayerActive(p) && gv_mbVote[p] == mode) { count += 1; } p += 1; }
    return count;
}

void MB_UpdateVoteUI () {
    int blind = MB_CountVotes(MB_MODE_BLIND);
    int sd = MB_CountVotes(MB_MODE_SD);
    int remain = FixedToInt(TimerGetRemaining(gv_mbTimer));
    string s = "BLIND  " + IntToString(blind) + "표     |     SINGLE DRAFT  " + IntToString(sd) + "표     |     " + IntToString(remain) + "초";
    DialogControlSetPropertyAsText(gv_mbVoteInfo, c_triggerControlPropertyText, PlayerGroupAll(), StringToText(s));
}

void MB_UpdateTeamRevealFor (int viewer) {
    int p = 1;
    int row = 0;
    playergroup allies;
    string s;
    playergroup one;
    if (!MB_PlayerActive(viewer)) { return; }
    one = PlayerGroupSingle(viewer);
    allies = PlayerGroupAlliance(c_playerGroupAlly, viewer);
    PlayerGroupAdd(allies, viewer);

    while (row < 4) {
        DialogControlSetPropertyAsText(gv_mbTeamRow[row], c_triggerControlPropertyText, one, StringToText(""));
        row += 1;
    }
    row = 0;
    while (p <= 8 && row < 4) {
        if (MB_PlayerActive(p) && PlayerGroupHasPlayer(allies, p)) {
            s = "P" + IntToString(p) + "  " + TextToString(PlayerName(p)) + "     ";
            if (gv_mbUnit[p] == "") { s = s + "선택 중"; }
            else {
                s = s + MB_DisplayName(gv_mbUnit[p]);
                if (gv_mbCanReroll[p] && !gv_mbRerollUsed[p]) { s = s + "   · 리롤 가능"; }
            }
            DialogControlSetPropertyAsText(gv_mbTeamRow[row], c_triggerControlPropertyText, one, StringToText(s));
            row += 1;
        }
        p += 1;
    }
}

void MB_UpdateAllTeamReveal () {
    int p = 1;
    while (p <= 8) { MB_UpdateTeamRevealFor(p); p += 1; }
}

void MB_SetBlindSelectionState (int p) {
    playergroup one = PlayerGroupSingle(p);
    DialogControlSetEnabled(gv_mbTerranButton, one, false);
    DialogControlSetEnabled(gv_mbZergButton, one, false);
    DialogControlSetEnabled(gv_mbProtossButton, one, false);
    DialogControlSetEnabled(gv_mbRandomButton, one, false);
    if (gv_mbRaceChoice[p] == MB_RACE_RANDOM && !gv_mbRerollUsed[p]) {
        DialogControlSetVisible(gv_mbRerollButton, one, true);
        DialogControlSetEnabled(gv_mbRerollButton, one, true);
        DialogControlSetPropertyAsText(gv_mbRerollButton, c_triggerControlPropertyText, one, StringToText("REROLL · 즉시 재추첨"));
    }
    else {
        DialogControlSetVisible(gv_mbRerollButton, one, false);
    }
    DialogControlSetPropertyAsText(gv_mbBlindStatus, c_triggerControlPropertyText, one,
        StringToText("내 유닛  ·  " + MB_DisplayName(gv_mbUnit[p])));
}

//--------------------------------------------------------------------------------------------------
// Blind Random actions
//--------------------------------------------------------------------------------------------------
void MB_AssignRace (int player, int raceChoice, bool grantReroll) {
    string result;
    if (!MB_PlayerActive(player) || gv_mbUnit[player] != "") { return; }
    gv_mbRaceChoice[player] = raceChoice;
    gv_mbCanReroll[player] = grantReroll;
    gv_mbRerollUsed[player] = false;
    gv_mbPreviousUnit[player] = "";

    if (raceChoice == MB_RACE_TERRAN) { result = MB_DrawFromRace(MB_RACE_TERRAN, player, ""); }
    else if (raceChoice == MB_RACE_ZERG) { result = MB_DrawFromRace(MB_RACE_ZERG, player, ""); }
    else if (raceChoice == MB_RACE_PROTOSS) { result = MB_DrawFromRace(MB_RACE_PROTOSS, player, ""); }
    else { result = MB_DrawRandomRace(player, ""); }

    gv_mbUnit[player] = result;
    MB_SetBlindSelectionState(player);
    UIDisplayMessage(PlayerGroupAlliance(c_playerGroupAlly, player), c_messageAreaSubtitle,
        PlayerName(player) + StringToText(" → ") + StringToText(MB_DisplayName(result)));
    MB_UpdateAllTeamReveal();
}

void MB_RerollPlayer (int player) {
    string oldUnit;
    string newUnit;
    playergroup one;
    if (!MB_PlayerActive(player)) { return; }
    if (!gv_mbCanReroll[player] || gv_mbRerollUsed[player] || gv_mbUnit[player] == "") { return; }

    // Old result returns to the public pool immediately. Only this player's reroll excludes it.
    oldUnit = gv_mbUnit[player];
    gv_mbPreviousUnit[player] = oldUnit;
    gv_mbUnit[player] = "";
    newUnit = MB_DrawRandomRace(player, oldUnit);
    gv_mbUnit[player] = newUnit;
    gv_mbRerollUsed[player] = true;

    one = PlayerGroupSingle(player);
    DialogControlSetVisible(gv_mbRerollButton, one, true);
    DialogControlSetEnabled(gv_mbRerollButton, one, false);
    DialogControlSetPropertyAsText(gv_mbRerollButton, c_triggerControlPropertyText, one, StringToText("REROLL USED"));
    DialogControlSetPropertyAsText(gv_mbBlindStatus, c_triggerControlPropertyText, one,
        StringToText("내 유닛  ·  " + MB_DisplayName(newUnit)));

    UIDisplayMessage(PlayerGroupAlliance(c_playerGroupAlly, player), c_messageAreaSubtitle,
        PlayerName(player) + StringToText(" 리롤: ") + StringToText(MB_DisplayName(oldUnit)) + StringToText(" → ") + StringToText(MB_DisplayName(newUnit)));
    MB_UpdateAllTeamReveal();
}

//--------------------------------------------------------------------------------------------------
// Single Draft board generation
//--------------------------------------------------------------------------------------------------
int MB_SDCountAir () {
    int i = 0; int n = 0;
    while (i < MB_SD_CANDIDATES) { if (MB_IsAir(gv_mbSDCandidate[i])) { n += 1; } i += 1; }
    return n;
}
int MB_SDCountDirect () {
    int i = 0; int n = 0;
    while (i < MB_SD_CANDIDATES) { if (MB_UnitRole(gv_mbSDCandidate[i]) == MB_ROLE_DIRECT) { n += 1; } i += 1; }
    return n;
}
int MB_SDCountCaster () {
    int i = 0; int n = 0;
    while (i < MB_SD_CANDIDATES) { if (MB_UnitRole(gv_mbSDCandidate[i]) == MB_ROLE_CASTER) { n += 1; } i += 1; }
    return n;
}
int MB_SDCountHigh () {
    int i = 0; int n = 0;
    while (i < MB_SD_CANDIDATES) { if (MB_IsHighWorkload(gv_mbSDCandidate[i])) { n += 1; } i += 1; }
    return n;
}
int MB_SDCountReliableAA () {
    int i = 0; int n = 0;
    while (i < MB_SD_CANDIDATES) { if (MB_AAScore2(gv_mbSDCandidate[i]) == 2) { n += 1; } i += 1; }
    return n;
}
int MB_SDAAScore2 () {
    int i = 0; int n = 0;
    while (i < MB_SD_CANDIDATES) { n += MB_AAScore2(gv_mbSDCandidate[i]); i += 1; }
    return n;
}

int MB_SDBoardPenalty () {
    int air = MB_SDCountAir();
    int direct = MB_SDCountDirect();
    int caster = MB_SDCountCaster();
    int high = MB_SDCountHigh();
    int reliable = MB_SDCountReliableAA();
    int aa = MB_SDAAScore2();
    int p = 0;
    if (air < 4) { p += (4 - air) * 12; }
    if (air > 10) { p += (air - 10) * 12; }
    if (direct < 15) { p += (15 - direct) * 8; }
    if (caster > 4) { p += (caster - 4) * 8; }
    if (high > 6) { p += (high - 6) * 5; }
    if (reliable < 4) { p += (4 - reliable) * 10; }
    if (aa < 10) { p += (10 - aa) * 5; }
    return p;
}

string MB_RandomUnusedCandidateFromRace (int race) {
    int count = MB_PoolCount(race);
    int start = RandomInt(0, count - 1);
    int step = 0;
    string u;
    while (step < count) {
        u = MB_PoolUnit(race, (start + step) % count);
        if (!MB_SDCandidateHas(u)) { return u; }
        step += 1;
    }
    return "";
}

void MB_SDComputeQuotas (int[3] q) {
    int total = gv_mbTerranCount + gv_mbZergCount + gv_mbProtossCount;
    int used;
    int remT;
    int remZ;
    int remP;
    q[0] = (MB_SD_CANDIDATES * gv_mbTerranCount) / total;
    q[1] = (MB_SD_CANDIDATES * gv_mbZergCount) / total;
    q[2] = (MB_SD_CANDIDATES * gv_mbProtossCount) / total;
    used = q[0] + q[1] + q[2];
    remT = (MB_SD_CANDIDATES * gv_mbTerranCount) % total;
    remZ = (MB_SD_CANDIDATES * gv_mbZergCount) % total;
    remP = (MB_SD_CANDIDATES * gv_mbProtossCount) % total;
    while (used < MB_SD_CANDIDATES) {
        if (remT >= remZ && remT >= remP) { q[0] += 1; remT = -1; }
        else if (remZ >= remT && remZ >= remP) { q[1] += 1; remZ = -1; }
        else { q[2] += 1; remP = -1; }
        used += 1;
    }
}

void MB_SDGenerateInitialBoard () {
    int[3] quota;
    int slot = 0;
    int race = 1;
    int n;
    int i = 0;
    MB_SDComputeQuotas(quota);
    while (i < MB_SD_CANDIDATES) { gv_mbSDCandidate[i] = ""; gv_mbSDTaken[i] = false; i += 1; }
    while (race <= 3) {
        n = 0;
        while (n < quota[race - 1]) {
            gv_mbSDCandidate[slot] = MB_RandomUnusedCandidateFromRace(race);
            slot += 1;
            n += 1;
        }
        race += 1;
    }
}

void MB_SDRepairBoard () {
    int attempts = 0;
    int oldPenalty;
    int newPenalty;
    int slot;
    int race;
    string oldUnit;
    string newUnit;

    while (MB_SDBoardPenalty() > 0 && attempts < 700) {
        oldPenalty = MB_SDBoardPenalty();
        slot = RandomInt(0, MB_SD_CANDIDATES - 1);
        race = MB_UnitRace(gv_mbSDCandidate[slot]);
        oldUnit = gv_mbSDCandidate[slot];
        gv_mbSDCandidate[slot] = "";
        newUnit = MB_RandomUnusedCandidateFromRace(race);
        if (newUnit == "") {
            gv_mbSDCandidate[slot] = oldUnit;
        }
        else {
            gv_mbSDCandidate[slot] = newUnit;
            newPenalty = MB_SDBoardPenalty();
            if (newPenalty > oldPenalty) { gv_mbSDCandidate[slot] = oldUnit; }
        }
        attempts += 1;
    }

    // Extremely unlikely fallback: regenerate once and repair again rather than accepting a broken board.
    if (MB_SDBoardPenalty() > 0) {
        MB_SDGenerateInitialBoard();
        attempts = 0;
        while (MB_SDBoardPenalty() > 0 && attempts < 700) {
            oldPenalty = MB_SDBoardPenalty();
            slot = RandomInt(0, MB_SD_CANDIDATES - 1);
            race = MB_UnitRace(gv_mbSDCandidate[slot]);
            oldUnit = gv_mbSDCandidate[slot];
            gv_mbSDCandidate[slot] = "";
            newUnit = MB_RandomUnusedCandidateFromRace(race);
            if (newUnit == "") { gv_mbSDCandidate[slot] = oldUnit; }
            else {
                gv_mbSDCandidate[slot] = newUnit;
                newPenalty = MB_SDBoardPenalty();
                if (newPenalty > oldPenalty) { gv_mbSDCandidate[slot] = oldUnit; }
            }
            attempts += 1;
        }
    }
}

void MB_SDShuffleTeamArray (int team) {
    int count;
    int i;
    int j;
    int tmp;
    if (team == 0) { count = gv_mbTeamACount; }
    else { count = gv_mbTeamBCount; }
    i = count - 1;
    while (i > 0) {
        j = RandomInt(0, i);
        if (team == 0) { tmp = gv_mbTeamAPlayers[i]; gv_mbTeamAPlayers[i] = gv_mbTeamAPlayers[j]; gv_mbTeamAPlayers[j] = tmp; }
        else { tmp = gv_mbTeamBPlayers[i]; gv_mbTeamBPlayers[i] = gv_mbTeamBPlayers[j]; gv_mbTeamBPlayers[j] = tmp; }
        i -= 1;
    }
}

void MB_SDBuildTeamsAndOrder () {
    int p = 1;
    int first = 0;
    playergroup allies;
    int a = 0;
    int b = 0;
    int i = 0;
    int team;
    int startTeam = RandomInt(0, 1);
    int pattern;

    gv_mbTeamACount = 0;
    gv_mbTeamBCount = 0;
    while (p <= 8) { if (first == 0 && MB_PlayerActive(p)) { first = p; } p += 1; }
    if (first == 0) { gv_mbSDOrderCount = 0; return; }

    allies = PlayerGroupAlliance(c_playerGroupAlly, first);
    PlayerGroupAdd(allies, first);
    p = 1;
    while (p <= 8) {
        if (MB_PlayerActive(p)) {
            if (PlayerGroupHasPlayer(allies, p)) { gv_mbTeamAPlayers[gv_mbTeamACount] = p; gv_mbTeamACount += 1; }
            else { gv_mbTeamBPlayers[gv_mbTeamBCount] = p; gv_mbTeamBCount += 1; }
        }
        p += 1;
    }

    MB_SDShuffleTeamArray(0);
    MB_SDShuffleTeamArray(1);
    gv_mbSDOrderCount = gv_mbTeamACount + gv_mbTeamBCount;
    i = 0;
    while (i < gv_mbSDOrderCount) {
        pattern = i % 8;
        if (pattern == 0 || pattern == 3 || pattern == 4 || pattern == 7) { team = startTeam; }
        else { team = 1 - startTeam; }

        if (team == 0 && a < gv_mbTeamACount) { gv_mbSDOrder[i] = gv_mbTeamAPlayers[a]; a += 1; }
        else if (team == 1 && b < gv_mbTeamBCount) { gv_mbSDOrder[i] = gv_mbTeamBPlayers[b]; b += 1; }
        else if (a < gv_mbTeamACount) { gv_mbSDOrder[i] = gv_mbTeamAPlayers[a]; a += 1; }
        else { gv_mbSDOrder[i] = gv_mbTeamBPlayers[b]; b += 1; }
        i += 1;
    }
}

int MB_SDPlayerTeam (int p) {
    int i = 0;
    while (i < gv_mbTeamACount) { if (gv_mbTeamAPlayers[i] == p) { return 0; } i += 1; }
    return 1;
}

void MB_SDUpdateBoardButtons () {
    int i = 0;
    string s;
    while (i < MB_SD_CANDIDATES) {
        if (gv_mbSDTaken[i]) { s = "LOCKED\n" + MB_DisplayName(gv_mbSDCandidate[i]); }
        else { s = MB_DisplayName(gv_mbSDCandidate[i]); }
        DialogControlSetPropertyAsText(gv_mbSDButton[i], c_triggerControlPropertyText, PlayerGroupAll(), StringToText(s));
        DialogControlSetEnabled(gv_mbSDButton[i], PlayerGroupAll(), false);
        i += 1;
    }
    if (gv_mbSDPickIndex < gv_mbSDOrderCount) {
        i = 0;
        while (i < MB_SD_CANDIDATES) {
            if (!gv_mbSDTaken[i]) { DialogControlSetEnabled(gv_mbSDButton[i], PlayerGroupSingle(gv_mbSDOrder[gv_mbSDPickIndex]), true); }
            i += 1;
        }
    }
}

void MB_SDUpdateOrderText () {
    int i = 0;
    int p;
    int team;
    string line;
    text t = StringToText("PICK ORDER\n\n");
    while (i < gv_mbSDOrderCount) {
        p = gv_mbSDOrder[i];
        team = MB_SDPlayerTeam(p);
        line = IntToString(i + 1) + ".  [";
        if (team == 0) { line = line + "BLUE"; } else { line = line + "RED"; }
        line = line + "] P" + IntToString(p) + "  ";
        if (i < gv_mbSDPickIndex) { line = line + MB_DisplayName(gv_mbUnit[p]); }
        else if (i == gv_mbSDPickIndex) { line = line + "< 선택 중 >"; }
        else { line = line + "대기"; }
        t = t + MB_TeamTagText(team, line) + StringToText("\n");
        i += 1;
    }
    DialogControlSetPropertyAsText(gv_mbSDOrderLabel, c_triggerControlPropertyText, PlayerGroupAll(), t);
}

void MB_SDUpdateTurn () {
    int p;
    int remain;
    if (gv_mbSDPickIndex >= gv_mbSDOrderCount) { return; }
    p = gv_mbSDOrder[gv_mbSDPickIndex];
    remain = FixedToInt(TimerGetRemaining(gv_mbTimer));
    DialogControlSetPropertyAsText(gv_mbSDCurrentLabel, c_triggerControlPropertyText, PlayerGroupAll(),
        MB_TeamTagText(MB_SDPlayerTeam(p), "NOW PICKING   ·   P" + IntToString(p) + "   " + TextToString(PlayerName(p))));
    DialogControlSetPropertyAsText(gv_mbSDInfo, c_triggerControlPropertyText, PlayerGroupAll(),
        StringToText("남은 시간  " + IntToString(remain) + "초     ·     선택된 유닛은 즉시 잠깁니다"));
    MB_SDUpdateBoardButtons();
    MB_SDUpdateOrderText();
}

//--------------------------------------------------------------------------------------------------
// Production restrictions
//--------------------------------------------------------------------------------------------------
void MB_SetAllMonoUnitsAllowed (int p, bool allowed) {
    int race = 1;
    int i;
    while (race <= 3) {
        i = 0;
        while (i < MB_PoolCount(race)) { TechTreeUnitAllow(p, MB_PoolUnit(race, i), allowed); i += 1; }
        race += 1;
    }
}

void MB_AllowPrecursors (int p, string selected) {
    if (selected == "Baneling") { TechTreeUnitAllow(p, "Zergling", true); }
    else if (selected == "Ravager") { TechTreeUnitAllow(p, "Roach", true); }
    else if (selected == "LurkerMP") { TechTreeUnitAllow(p, "Hydralisk", true); }
    else if (selected == "BroodLord") { TechTreeUnitAllow(p, "Corruptor", true); }
    else if (selected == "Hellbat") { TechTreeUnitAllow(p, "Hellion", true); }
    else if (selected == "Archon") {
        TechTreeUnitAllow(p, "HighTemplar", true);
        TechTreeUnitAllow(p, "DarkTemplar", true);
    }
}

void MB_ApplyProductionRestrictionsFor (int p) {
    if (!MB_PlayerActive(p) || gv_mbUnit[p] == "") { return; }
    MB_SetAllMonoUnitsAllowed(p, false);
    TechTreeUnitAllow(p, gv_mbUnit[p], true);
    MB_AllowPrecursors(p, gv_mbUnit[p]);
    // Non-selectable support units (workers, Medivac transport, Observer, Warp Prism, Overseer, etc.)
    // remain on normal melee tech rules in this first restriction pass.
}

void MB_ApplyProductionRestrictionsAll () {
    int p = 1;
    while (p <= 8) { MB_ApplyProductionRestrictionsFor(p); p += 1; }
}

